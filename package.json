{
  "name": "dsh-theme-nezuko",
  "version": "1.0.1",
  "private": true,
  "description": "祢豆子 · 月下守护 — Nezuko Moonlit Guardian theme for DeepSeek Harness Web",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE-NOTICE.md",
    "assets/OFL-NotoSans.txt",
    "assets/OFL-NotoSerif.txt"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs"
  }
}
